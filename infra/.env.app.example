# Configuração do Django em produção. No servidor: /opt/eumini/.env.app (chmod 600).
# DJANGO_SECRET_KEY e FIELD_ENCRYPTION_KEY são gerados pelo bootstrap-secrets.sh, no próprio
# servidor. As chaves de terceiros são copiadas sem passar pela tela. Nunca versione o real.
# DATABASE_URL vem do compose.

# --- Django ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
# Domínios públicos + `web` (nome interno usado pelo Next) + localhost (healthcheck).
DJANGO_ALLOWED_HOSTS=eumini.com,www.eumini.com,parceiros.eumini.com,equipe.eumini.com,web,localhost
# O HTTPS é garantido pela Cloudflare. O Next fala com o Django por http interno, então o
# redirecionamento do Django quebraria o BFF.
DJANGO_SECURE_SSL_REDIRECT=False
FIELD_ENCRYPTION_KEY=
# IP do visitante: a Cloudflare grava em CF-Connecting-IP e sobrescreve o que o cliente mandar.
CLIENT_IP_HEADER=CF-Connecting-IP
NUM_PROXIES=0
CONSUMER_APP_URL=https://eumini.com
# App de parceiros: links dos e-mails de convite, atribuição, etiqueta e cancelamento.
PARTNERS_APP_URL=https://parceiros.eumini.com
INTERNAL_PARTNER_POSTAL_CODE=01001000
DAILY_SPEND_CAP_USD=30

# --- Adapters ---
IMAGE_GENERATION_ADAPTER=integrations.adapters.runware.RunwareImageGenerationAdapter
IMAGE_CLASSIFICATION_ADAPTER=integrations.adapters.typesafe.TypeSafeClassificationAdapter
PAYMENT_GATEWAY_ADAPTER=integrations.adapters.abacatepay.AbacatePayAdapter
SHIPPING_ADAPTER=integrations.adapters.stubs.StubShippingAdapter
ADDRESS_LOOKUP_ADAPTER=integrations.adapters.viacep.ViaCepAdapter
MEDIA_STORAGE_ADAPTER=integrations.adapters.media_s3.S3MediaAdapter
EMAIL_ADAPTER=integrations.adapters.email_smtp.SmtpEmailAdapter

# --- Chaves de terceiros (copiadas do .env local no ensaio; trocadas no lançamento) ---
RUNWARE_API_KEY=
RUNWARE_IMAGE_MODEL=openai:gpt-image@2
RUNWARE_IMAGE_FALLBACK_MODEL=google:4@2
JEV_API_KEY=
JEV_MODEL=jev-1.14.0
ABACATE_PAY_BASE_URL=https://api.abacatepay.com/v2
ABACATE_PAY_API_KEY=
ABACATE_PAY_WEBHOOK_SECRET=

# --- S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=sa-east-1
AWS_STORAGE_BUCKET_NAME=

# --- E-mail ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
