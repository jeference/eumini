# Variáveis do compose de produção. No servidor: /opt/eumini/.env (chmod 600).
# POSTGRES_PASSWORD é gerada pelo bootstrap-secrets.sh; TAG e SRC_DIR, pelo update.sh.
# Nunca versione o arquivo real.

TAG=
SRC_DIR=./src
# Senha do banco, só caracteres seguros em URL (o bootstrap gera em hexadecimal).
POSTGRES_PASSWORD=
# Token do túnel eumini-prod (Cloudflare). Só o container cloudflared recebe.
TUNNEL_TOKEN=
# Valores públicos, gravados no JavaScript do site no build.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_ABACATEPAY_PUBLIC_KEY=
