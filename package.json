{
  "name": "eumini",
  "version": "0.1.0",
  "private": true,
  "description": "EuMini: crie um modelo com IA e receba a peça impressa em 3D.",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @eumini/consumer dev",
    "dev:partners": "pnpm --filter @eumini/partners dev",
    "build": "pnpm --filter @eumini/consumer build && pnpm --filter @eumini/partners build",
    "start": "pnpm --filter @eumini/consumer start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx,css}\""
  },
  "devDependencies": { "prettier": "^3.4.2" }
}
